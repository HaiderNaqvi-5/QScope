# QSScope Environment Configuration Template
# Copy this file to .env and configure for local development

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=true
DEBUG=false

# Frontend Development
FRONTEND_PORT=3000
FRONTEND_NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Database
DATABASE_URL=sqlite:///./app.db
DATABASE_ECHO=false

# QSScope Data Directory
QSSCOPE_DATA_DIR=.qsscope

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI/LLM Configuration (Groq API)
# Only set if using AI features
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=3
GROQ_MAX_CONCURRENT_REQUESTS=2
QSSCOPE_LLM_ENABLED=true
GROQ_MAX_TOKENS=2048

# Optional: External Tool Paths
# If tools are not in PATH, specify absolute paths
SEMGREP_PATH=
TRIVY_PATH=
GITLEAKS_PATH=
ZAP_PATH=

# Feature Flags
ENABLE_ADVANCED_TESTING=true

# Performance
SCAN_TIMEOUT=3600
TOOL_TIMEOUT=300
MAX_FILE_SIZE_MB=100
